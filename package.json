{
  "name": "scout-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "check:security": "node scripts/check-security.mjs",
    "audit:security": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:security"
  },
  "dependencies": {
    "pinia": "^3.0.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.1.4",
    "vue-tsc": "^2.2.10"
  }
}
